  "item": [
    {
      "name": "API Autenticar Cliente via Lambda (CPF) — Fase 3 Serverless",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "const jwtToken = responseData.token || responseData.accessToken;",
              "",
              "pm.collectionVariables.set(\"jwtToken\", jwtToken);",
              "pm.environment.set(\"jwtToken\", jwtToken);",
              "",
              "console.log(\"Token JWT (CLIENTE) salvo: \" + jwtToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cpf\": \"529.982.247-25\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        },
        "description": "Autenticação serverless de cliente por CPF via AWS Lambda. Retorna token JWT com role CLIENTE."
      },
      "response": []
    },
    {
      "name": "API Autenticar Usuário Interno (Login/Senha) — EKS Backend",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "const jwtToken = responseData.accessToken || responseData.token;",
              "",
              "pm.collectionVariables.set(\"jwtToken\", jwtToken);",
              "pm.environment.set(\"jwtToken\", jwtToken);",
              "",
              "console.log(\"Token JWT (INTERNO) salvo: \" + jwtToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"gerente\",\n    \"senha\": \"senha@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{url}}/auth/login",
          "host": [
            "{{url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Autenticação legada de usuário interno (gerente, atendente, mecânico) via aplicação Spring Boot no EKS."
      },
      "response": []
    },
