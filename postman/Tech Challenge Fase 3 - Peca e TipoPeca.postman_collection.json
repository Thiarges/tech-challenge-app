            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"gerente\",\n    \"senha\": \"senha@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
