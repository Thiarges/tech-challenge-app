# Este arquivo é apenas um template de referência.
# Os Secrets reais são criados pela pipeline de CI/CD (deploy.yml)
# usando os valores dos Secrets do GitHub Actions — nunca commite valores reais aqui.
#
# Para criar manualmente (substituindo os valores):
#   kubectl create secret generic app-secrets \
#     --namespace=tech-challenge \
#     --from-literal=SPRING_DATASOURCE_URL="jdbc:postgresql://HOST:5432/oficina" \
#     --from-literal=SPRING_DATASOURCE_USERNAME="usuario" \
#     --from-literal=SPRING_DATASOURCE_PASSWORD="senha" \
#     --from-literal=JWT_SECRET="sua-chave-secreta-minimo-32-chars" \
#     --from-literal=WEBHOOK_APROVACAO_SECRET="webhook-secret"
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: tech-challenge
type: Opaque
stringData:
  SPRING_DATASOURCE_URL: "jdbc:postgresql://PLACEHOLDER:5432/oficina"
  SPRING_DATASOURCE_USERNAME: "PLACEHOLDER"
  SPRING_DATASOURCE_PASSWORD: "PLACEHOLDER"
  JWT_SECRET: "PLACEHOLDER-minimo-32-caracteres!!!"
  WEBHOOK_APROVACAO_SECRET: "PLACEHOLDER"
